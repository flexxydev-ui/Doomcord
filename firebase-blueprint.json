{
  "entities": {
    "User": {
      "title": "User",
      "description": "Real registered user account with role, APEX membership status, permanent entitlements, and equipped cosmetics",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 32, "pattern": "^[a-z0-9_.-]+$" },
        "displayName": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["root_owner", "secondary_owner", "owner", "admin", "moderator", "member"] },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "bannerURL": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 300 },
        "statusMessage": { "type": "string", "maxLength": 100 },
        "presence": { "type": "string", "enum": ["online", "idle", "dnd", "invisible"] },
        "accentColor": { "type": "string", "maxLength": 40 },
        "secondaryColor": { "type": "string", "maxLength": 40 },
        "nitroTier": { "type": "string", "enum": ["free", "basic", "nitro"] },
        "nitroBillingCycle": { "type": "string", "enum": ["none", "monthly", "yearly", "lifetime"] },
        "nitroExpiresAt": { "type": "string" },
        "nitroAutoRenew": { "type": "boolean" },
        "permanentEntitlement": { "type": "string", "maxLength": 64 },
        "ownedCosmetics": { "type": "array" },
        "equippedCosmetics": { "type": "object" },
        "badges": { "type": "array" },
        "isBanned": { "type": "boolean" },
        "isSuspended": { "type": "boolean" },
        "mustChangePassword": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "username", "displayName"]
    },
    "NitroPlan": {
      "title": "ApexPlan",
      "description": "Configurable Doomcord APEX membership tier in INR",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "tier": { "type": "string", "enum": ["free", "basic", "nitro"] },
        "name": { "type": "string", "maxLength": 60 },
        "tagline": { "type": "string", "maxLength": 200 },
        "monthlyPriceINR": { "type": "number" },
        "yearlyPriceINR": { "type": "number" },
        "uploadLimitMB": { "type": "number" },
        "maxMessageLength": { "type": "number" },
        "shopDiscountPercent": { "type": "number" },
        "benefits": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tier", "name", "monthlyPriceINR", "yearlyPriceINR"]
    },
    "CosmeticItem": {
      "title": "CosmeticItem",
      "description": "Original Doomcord APEX Collection cosmetic item or bundle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 50 },
        "priceINR": { "type": "number" },
        "rarity": { "type": "string", "enum": ["Common", "Rare", "Epic", "Legendary", "Mythic"] },
        "nitroEligible": { "type": "string", "enum": ["none", "basic", "nitro"] },
        "cssPreviewClass": { "type": "string", "maxLength": 200 },
        "previewColorPrimary": { "type": "string", "maxLength": 40 },
        "previewColorSecondary": { "type": "string", "maxLength": 40 },
        "enabled": { "type": "boolean" },
        "isLimitedEdition": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "priceINR", "rarity"]
    },
    "Gift": {
      "title": "Gift",
      "description": "Owner-generated complimentary APEX membership or cosmetic gift with hashed redemption token",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tokenHash": { "type": "string", "maxLength": 128 },
        "tokenPreview": { "type": "string", "maxLength": 64 },
        "creatorUid": { "type": "string", "maxLength": 128 },
        "creatorName": { "type": "string", "maxLength": 80 },
        "apexTier": { "type": "string", "enum": ["none", "basic", "nitro"] },
        "cosmeticIds": { "type": "array" },
        "duration": { "type": "string", "enum": ["1d", "7d", "30d", "90d", "1y", "lifetime"] },
        "personalMessage": { "type": "string", "maxLength": 500 },
        "restrictedRecipientUid": { "type": "string", "maxLength": 128 },
        "restrictedRecipientEmail": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["unclaimed", "redeemed", "revoked", "expired"] },
        "redeemedByUid": { "type": "string", "maxLength": 128 },
        "redeemedByEmail": { "type": "string", "maxLength": 128 },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "linkExpiresAt": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tokenHash", "creatorUid", "duration", "status", "createdAt"]
    },
    "GiftRedemption": {
      "title": "GiftRedemption",
      "description": "Immutable record of an atomic gift redemption event",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "giftId": { "type": "string", "maxLength": 128 },
        "recipientUid": { "type": "string", "maxLength": 128 },
        "recipientEmail": { "type": "string", "maxLength": 128 },
        "apexTierGranted": { "type": "string", "maxLength": 32 },
        "cosmeticsGranted": { "type": "array" },
        "duration": { "type": "string", "maxLength": 32 },
        "entitlementExpiresAt": { "type": "string" },
        "redeemedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "giftId", "recipientUid", "redeemedAt"]
    },
    "UserEntitlement": {
      "title": "UserEntitlement",
      "description": "Persistent user entitlement for OWNER_PERMANENT_APEX, gifted APEX memberships, or permanent cosmetics",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "entitlementCode": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "enum": ["owner_permanent", "gift", "razorpay", "admin_grant"] },
        "sourceId": { "type": "string", "maxLength": 128 },
        "apexTier": { "type": "string", "enum": ["none", "basic", "nitro"] },
        "cosmeticIds": { "type": "array" },
        "isLifetime": { "type": "boolean" },
        "expiresAt": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "entitlementCode", "source", "isLifetime", "active", "createdAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Verified Razorpay payment or subscription transaction record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["nitro_subscription", "cosmetic_purchase", "admin_grant", "refund"] },
        "itemId": { "type": "string", "maxLength": 128 },
        "itemName": { "type": "string", "maxLength": 120 },
        "amountINR": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "status": { "type": "string", "enum": ["created", "verified", "captured", "failed", "refunded"] },
        "razorpayOrderId": { "type": "string", "maxLength": 128 },
        "razorpayPaymentId": { "type": "string", "maxLength": 128 },
        "razorpaySignature": { "type": "string", "maxLength": 256 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amountINR", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative and security audit trail record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "action", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Platform-wide configuration, announcements, and Razorpay settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "merchantUpiId": { "type": "string", "maxLength": 100 },
        "maintenanceMode": { "type": "boolean" },
        "globalAnnouncement": { "type": "string", "maxLength": 500 },
        "globalDiscountPercent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Social friend request document",
      "type": "object",
      "properties": {
        "fromUid": { "type": "string", "maxLength": 128 },
        "toUid": { "type": "string", "maxLength": 128 },
        "fromUsername": { "type": "string", "maxLength": 50 },
        "toUsername": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUid", "toUid", "status"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Direct message thread between real users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "lastMessageText": { "type": "string", "maxLength": 1000 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message with attachments, reactions, and read receipts",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 50 },
        "senderAvatar": { "type": "string", "maxLength": 2048 },
        "content": { "type": "string", "maxLength": 4000 },
        "readBy": { "type": "array" },
        "reactions": { "type": "object" },
        "attachments": { "type": "array" },
        "isEdited": { "type": "boolean" },
        "isPinned": { "type": "boolean" },
        "replyTo": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "createdAt"]
    },
    "Community": {
      "title": "Community",
      "description": "Social community server created by a real user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 400 },
        "iconUrl": { "type": "string", "maxLength": 2048 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "themeColor": { "type": "string", "maxLength": 40 },
        "isPublic": { "type": "boolean" },
        "members": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "Channel": {
      "title": "Channel",
      "description": "Community channel for text, announcement, voice, or stage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "communityId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 40 },
        "topic": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "enum": ["text", "announcement", "voice", "stage"] },
        "position": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["communityId", "name", "type"]
    },
    "Orb": {
      "title": "Orb",
      "description": "Signature spatial interest realm created by a real user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 40 },
        "icon": { "type": "string", "maxLength": 50 },
        "primaryColor": { "type": "string", "maxLength": 30 },
        "secondaryColor": { "type": "string", "maxLength": 30 },
        "visibility": { "type": "string", "enum": ["public", "friends", "private"] },
        "creatorId": { "type": "string", "maxLength": 128 },
        "memberCount": { "type": "number" },
        "activityScore": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "creatorId", "visibility"]
    },
    "VoiceRoom": {
      "title": "VoiceRoom",
      "description": "Live WebRTC audio room state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "channelId": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["channelId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile, role, APEX membership, and cosmetics"
    },
    "/nitro_plans/{planId}": {
      "schema": "NitroPlan",
      "description": "Doomcord APEX membership plans and INR pricing"
    },
    "/cosmetics/{cosmeticId}": {
      "schema": "CosmeticItem",
      "description": "Doomcord APEX Collection catalog"
    },
    "/gifts/{giftId}": {
      "schema": "Gift",
      "description": "Owner-generated complimentary APEX gifts with hashed tokens"
    },
    "/gift_redemptions/{redemptionId}": {
      "schema": "GiftRedemption",
      "description": "Atomic gift redemption records"
    },
    "/user_entitlements/{entitlementId}": {
      "schema": "UserEntitlement",
      "description": "Persistent user entitlements (OWNER_PERMANENT_APEX, lifetime gifts, cosmetics)"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Verified Razorpay and store transaction records"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Owner and administrator action audit logs"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "Platform settings, UPI ID reference, and global banners"
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "Real incoming and outgoing friend requests"
    },
    "/direct_messages/{dmId}": {
      "schema": "DirectMessage",
      "description": "Direct message threads"
    },
    "/direct_messages/{dmId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside direct message threads"
    },
    "/communities/{communityId}": {
      "schema": "Community",
      "description": "Real user-created communities"
    },
    "/communities/{communityId}/channels/{channelId}": {
      "schema": "Channel",
      "description": "Channels inside communities"
    },
    "/communities/{communityId}/channels/{channelId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages inside community channels"
    },
    "/orbs/{orbId}": {
      "schema": "Orb",
      "description": "Signature spatial Orbs"
    },
    "/orbs/{orbId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Live discussion messages within an Orb"
    },
    "/voice_rooms/{roomId}": {
      "schema": "VoiceRoom",
      "description": "Active WebRTC voice rooms"
    }
  }
}
