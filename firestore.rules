rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // --- USERS ---
    function isValidUser(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.username is string && data.username.size() >= 2 && data.username.size() <= 32 &&
             data.displayName is string && data.displayName.size() <= 50;
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                       request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                       request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // --- FRIEND REQUESTS ---
    function isValidFriendRequest(data) {
      return data.fromUid is string && data.fromUid.size() <= 128 &&
             data.toUid is string && data.toUid.size() <= 128 &&
             data.status in ['pending', 'accepted', 'rejected'];
    }

    match /friend_requests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) &&
                       isValidFriendRequest(request.resource.data) &&
                       request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && isValidId(requestId) &&
                       (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow delete: if isSignedIn() &&
                       (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // --- DIRECT MESSAGES ---
    match /direct_messages/{dmId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(dmId) &&
                       request.resource.data.participants is list &&
                       request.resource.data.participants.hasAny([request.auth.uid]);
      allow update: if isSignedIn() && isValidId(dmId) &&
                       resource.data.participants.hasAny([request.auth.uid]);
      allow delete: if isSignedIn() &&
                       resource.data.participants.hasAny([request.auth.uid]);

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId) &&
                         request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(messageId);
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // --- COMMUNITIES ---
    function isValidCommunity(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.ownerId is string && data.ownerId.size() <= 128;
    }

    match /communities/{communityId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(communityId) &&
                       isValidCommunity(request.resource.data) &&
                       request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(communityId);
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /channels/{channelId} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn() && isValidId(channelId);
        allow delete: if isSignedIn();

        match /messages/{messageId} {
          allow get, list: if isSignedIn();
          allow create: if isSignedIn() && isValidId(messageId) &&
                           request.resource.data.senderId == request.auth.uid;
          allow update: if isSignedIn() && isValidId(messageId);
          allow delete: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.senderId == null);
        }
      }
    }

    // --- ORBS ---
    function isValidOrb(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
             data.category is string && data.category.size() <= 40 &&
             data.creatorId is string && data.creatorId.size() <= 128;
    }

    match /orbs/{orbId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(orbId) &&
                       isValidOrb(request.resource.data) &&
                       request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(orbId);
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isValidId(messageId) &&
                         request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(messageId);
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // --- VOICE ROOMS ---
    match /voice_rooms/{roomId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(roomId);
    }
  }
}
