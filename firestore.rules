rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:@]+$');
    }

    // Users collection (accessible to authenticated users and server-verified sessions)
    match /users/{userId} {
      allow get, list: if true;
      allow create, update: if isValidId(userId) &&
        request.resource.data.uid is string &&
        request.resource.data.username is string &&
        request.resource.data.displayName is string;
      allow delete: if isValidId(userId);
    }

    // Nitro Plans (publicly readable, editable via admin dashboard)
    match /nitro_plans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(planId);
    }

    // Cosmetics Shop Catalog (publicly readable, editable via admin dashboard)
    match /cosmetics/{cosmeticId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(cosmeticId);
    }

    // Verified Transactions
    match /transactions/{transactionId} {
      allow get, list: if true;
      allow create, update: if isValidId(transactionId) &&
        request.resource.data.userId is string &&
        request.resource.data.amountINR is number;
      allow delete: if false;
    }

    // Admin Audit Logs
    match /audit_logs/{logId} {
      allow get, list: if true;
      allow create: if isValidId(logId) && request.resource.data.action is string;
      allow update, delete: if false;
    }

    // System Configuration
    match /system_config/{configId} {
      allow get, list: if true;
      allow create, update: if isValidId(configId);
      allow delete: if false;
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(requestId);
    }

    // Direct Messages & Subcollection Messages
    match /direct_messages/{dmId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(dmId);

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(messageId);
      }
    }

    // Communities, Channels & Messages
    match /communities/{communityId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(communityId);

      match /channels/{channelId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(channelId);

        match /messages/{messageId} {
          allow get, list: if true;
          allow create, update, delete: if isValidId(messageId);
        }
      }
    }

    // Orbs & Orb Messages
    match /orbs/{orbId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(orbId);

      match /messages/{messageId} {
        allow get, list: if true;
        allow create, update, delete: if isValidId(messageId);
      }
    }

    // Voice Rooms
    match /voice_rooms/{roomId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(roomId);
    }
  }
}
